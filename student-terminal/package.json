{
  "name": "student-secure-terminal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest",
    "start": "electron .",
    "build:electron": "electron-builder",
    "package": "npm run build && npm run build:electron",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "build:android": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "build:android:release": "npm run build && npx cap sync android && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "jsdom": "^26.1.0",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1",
    "vitest": "^3.2.4"
  },
  "main": "main.cjs",
  "build": {
    "appId": "com.secureems.student",
    "productName": "Student Secure Terminal",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable"
    },
    "files": [
      "dist/**/*",
      "main.cjs"
    ]
  }
}
