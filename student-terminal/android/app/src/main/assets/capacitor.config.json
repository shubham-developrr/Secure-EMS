{
	"appId": "com.secureems.student.kiosk",
	"appName": "Secure EMS Student Kiosk",
	"webDir": "dist",
	"bundledWebRuntime": false,
	"server": {
		"androidScheme": "https",
		"cleartext": true,
		"allowNavigation": [
			"*"
		]
	},
	"android": {
		"allowMixedContent": true,
		"captureInput": true,
		"webContentsDebuggingEnabled": false,
		"backgroundColor": "#0f172a"
	}
}
