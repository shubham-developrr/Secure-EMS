<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow exam hall tablets/phones to connect to local LAN FastAPI servers (HTTP) as well as cloud HTTPS -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
